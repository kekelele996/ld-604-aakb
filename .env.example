# Compose 项目名（容器名统一前缀）
COMPOSE_PROJECT_NAME=grid-repair

# 前端宿主机访问端口（容器内 80）
FRONTEND_PORT=20104

# 后端宿主机访问端口（容器内 3000）
BACKEND_PORT=21104

# MySQL 宿主机映射端口（容器内 3306）
DB_PORT=33060

# 数据库凭据
DB_NAME=grid_repair
DB_USER=grid_user
DB_PASSWORD=grid_password

# 后端配置
PORT=3000
# 存储模式：memory=本地种子内存库（默认，开箱即用）；mysql=MySQL（需先执行 database/init.sql）
STORAGE=memory
JWT_SECRET=local-dev-secret
# 每分钟每 IP 最大请求数
RATE_LIMIT_MAX=120
