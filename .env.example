# Compose 项目名（容器名统一前缀，英文短名 grid-repair）
COMPOSE_PROJECT_NAME=grid-repair

# 前端宿主机访问端口（容器内固定 80）
FRONTEND_PORT=20104

# 后端宿主机访问端口（容器内固定 3000）
BACKEND_PORT=21104

# MySQL 宿主机映射端口（容器内固定 3306）
DB_PORT=33060

# 数据库凭据（db 与 backend 共享，新增项须同步 docker-compose.yml）
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# JWT 密钥（正式部署请修改）
JWT_SECRET=local-dev-secret
