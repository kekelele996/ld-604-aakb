// Prisma schema —— grid-repair 配网抢修工单系统
// 演示运行期使用内存种子数据（与 database/init.sql 等价）；
// 生产/联调时执行 prisma db push 即可在 MySQL 8.0 建表。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GridAsset {
  id            Int      @id @default(autoincrement())
  assetCode     String   @map("asset_code") @db.VarChar(64)
  assetType     String   @map("asset_type") @db.VarChar(64)
  feederLine    String   @map("feeder_line") @db.VarChar(128)
  voltageLevel  String   @map("voltage_level") @db.VarChar(16)
  locationDesc  String   @map("location_desc") @db.VarChar(255)
  healthStatus  String   @map("health_status") @db.VarChar(32)
  ownerTeamId   Int?     @map("owner_team_id")
  lastFaultAt   DateTime? @map("last_fault_at")
  faultCount    Int      @default(0) @map("fault_count")
  faults        FaultReport[]

  @@map("grid_asset")
}

model FaultReport {
  id            Int      @id @default(autoincrement())
  reporterName  String   @map("reporter_name") @db.VarChar(64)
  phone         String   @db.VarChar(32)
  asset         GridAsset @relation(fields: [assetId], references: [id])
  assetId       Int      @map("asset_id")
  faultType     String   @map("fault_type") @db.VarChar(32)
  addressDesc   String   @map("address_desc") @db.VarChar(255)
  severity      String   @db.VarChar(16)
  reportChannel String   @map("report_channel") @db.VarChar(32)
  status        String   @db.VarChar(16)
  mergedIntoId  Int?     @map("merged_into_id")
  ticketId      Int?     @map("ticket_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([assetId])
  @@index([status])
  @@map("fault_report")
}

model RepairTicket {
  id             Int      @id @default(autoincrement())
  faultReportId  Int      @map("fault_report_id")
  mergedReportIds Json    @map("merged_report_ids")
  teamId         Int?     @map("team_id")
  dispatcherId   Int      @map("dispatcher_id")
  priority       String   @db.VarChar(16)
  status         String   @db.VarChar(16)
  assignedAt     DateTime? @map("assigned_at")
  arrivedAt      DateTime? @map("arrived_at")
  repairingAt    DateTime? @map("repairing_at")
  restoredAt     DateTime? @map("restored_at")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  restoreRemark  String?  @map("restore_remark") @db.VarChar(255)
  partUsages     SparePartUsage[]

  @@index([status])
  @@map("repair_ticket")
}

model Crew {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(64)
  leaderId       Int      @map("leader_id")
  leaderName     String   @map("leader_name") @db.VarChar(64)
  skillTags      String   @map("skill_tags") @db.VarChar(255)
  dutyStatus     String   @map("duty_status") @db.VarChar(16)
  currentTicketId Int?    @map("current_ticket_id")
  contactPhone   String   @map("contact_phone") @db.VarChar(32)

  @@map("crew")
}

model SparePartUsage {
  id            Int      @id @default(autoincrement())
  ticket        RepairTicket @relation(fields: [ticketId], references: [id])
  ticketId      Int      @map("ticket_id")
  partCode      String   @map("part_code") @db.VarChar(64)
  partName      String   @map("part_name") @db.VarChar(128)
  quantity      Int
  warehouseName String   @map("warehouse_name") @db.VarChar(64)
  requestedBy   String   @map("requested_by") @db.VarChar(64)
  approvedBy    String?  @map("approved_by") @db.VarChar(64)
  approvedAt    DateTime? @map("approved_at")
  rejectReason  String?  @map("reject_reason") @db.VarChar(255)
  usageStatus   String   @map("usage_status") @db.VarChar(16)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("spare_part_usage")
}

model SparePartStock {
  partCode      String   @id @map("part_code") @db.VarChar(64)
  partName      String   @map("part_name") @db.VarChar(128)
  warehouseName String   @map("warehouse_name") @db.VarChar(64)
  stock         Int
  safetyStock   Int      @map("safety_stock")
  unit          String   @db.VarChar(16)

  @@map("spare_part_stock")
}

model StockTxn {
  id            Int      @id @default(autoincrement())
  partCode      String   @map("part_code") @db.VarChar(64)
  partName      String   @map("part_name") @db.VarChar(128)
  warehouseName String   @map("warehouse_name") @db.VarChar(64)
  changeQty     Int      @map("change_qty")
  balance       Int
  usageId       Int?     @map("usage_id")
  operator      String   @db.VarChar(64)
  remark        String   @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([partCode])
  @@map("stock_txn")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  actor         String   @db.VarChar(64)
  actorRole     String   @map("actor_role") @db.VarChar(16)
  action        String   @db.VarChar(255)
  targetType    String   @map("target_type") @db.VarChar(32)
  targetId      String   @map("target_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorRole])
  @@index([targetType])
  @@map("audit_log")
}
